> smooth_boundary2 <- ifelse(
+   abs(bin2 - lower2) <= abs(bin2 - upper2),
+   lower2,
+   upper2
+ )
> 
> smooth_boundary3 <- ifelse(
+   abs(bin3 - lower3) <= abs(bin3 - upper3),
+   lower3,
+   upper3
+ )
> 
> smooth_boundary <- c(
+   smooth_boundary1,
+   smooth_boundary2,
