> # Q2(ii) Data Smoothing using Bin Boundaries
> 
> lower1 <- min(bin1)
> upper1 <- max(bin1)
> 
> lower2 <- min(bin2)
> upper2 <- max(bin2)
> 
> lower3 <- min(bin3)
> upper3 <- max(bin3)
> 
> smooth_boundary1 <- ifelse(
+   abs(bin1 - lower1) <= abs(bin1 - upper1),
+   lower1,
+   upper1
+ )
